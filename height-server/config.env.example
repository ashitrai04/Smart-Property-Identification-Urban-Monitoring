# Copy to config.env and fill in. Only needed for global (tunnelled) mode,
# and only so the address can be published - the server itself runs without
# any of this.
#
# Copy the four R2_* values from the HiSup laptop, where they are already in
# the repo's .env. They let this laptop write its current public address to
# runtime/height_server.json, which is what makes HEIGHT_SERVER=auto work on
# the HiSup side across tunnel restarts.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=property-data

# Leave empty to have one generated and saved to cache/api_key.txt on the
# first global run. Set it to pin your own.
HS_API_KEY=

# Optional: a Cloudflare named tunnel gives a FIXED hostname instead of a new
# random one each restart. Create one in the Cloudflare dashboard under
# Zero Trust > Networks > Tunnels, paste the token here, and put the hostname
# you mapped it to in HS_PUBLIC_URL.
CF_TUNNEL_TOKEN=
HS_PUBLIC_URL=

# Where the elevation data is, if not the built-in defaults.
# HS_DSM_DIR=C:\Users\Asus\Downloads\DSM Data
# HS_DTM_DIR=C:\Users\Asus\Downloads\DTM Data
HS_PORT=8900
