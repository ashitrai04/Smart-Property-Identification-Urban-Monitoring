# Copy to config.env and edit. Loaded by run.sh / tunnel.sh.

PORT=8800

# Required for write operations (ingest imagery, start/cancel jobs, delete).
# Generate one:  python3 -c "import secrets; print(secrets.token_urlsafe(24))"
SP_API_KEY=change-me

# Same Cloudflare R2 bucket the webapp + HF Space use (large-file uploads ≤ 500 MB).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=property-data

# Webapp origins allowed to call this server (*.vercel.app previews are always allowed).
SP_CORS_ORIGINS=https://smart-property-identification-urban.vercel.app,http://localhost:5173,http://localhost:5179

# ── GPU / models ──
MIN_FREE_MB=2500             # below this free GPU memory, run.sh starts on CPU instead
SEG_BATCH=8                  # SegFormer chips per GPU batch (auto-halves on out-of-memory)
SEG_FP16=1                   # half precision on GPU
SEG_TTA=1                    # flip test-time augmentation (GPU only; HF Space has it off)
SEG_MAX_DIM=2048             # longest side before downscaling (HF Space: 1536)
FUSE_MAX_DIM=2048            # SAM fusion working size
SAM_MODEL_ID=facebook/sam-vit-base   # the HF Space uses vit-base; vit-large/huge are sharper but need more GPU memory

# ── imagery pipeline ──
SP_COG_PROFILE=jpeg          # jpeg (default) | webp (smaller) | deflate (lossless)
SP_COG_QUALITY=85
SP_JOB_WINDOW=1536           # px per window for whole-image segmentation jobs (≤ SEG_MAX_DIM)
SP_POTHOLE_WINDOW=4096       # px per window for pothole jobs (YOLO tiles inside at 1024)

# Optional: fixed public hostname via a Cloudflare named tunnel (see tunnel.sh)
CF_TUNNEL_TOKEN=
