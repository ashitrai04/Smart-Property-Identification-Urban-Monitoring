# Copy to config.env and edit. config.env is not in git.
# The SAME package runs on both laptops; only these values differ.

# A name you will recognise in the status output.
UN_NODE_NAME=laptop-a

# Where the survey data lives on THIS machine.
#   this laptop : D:\GEO_SERVE
#   other laptop: C:\Users\Asus\Downloads\GEO_SERVE
UN_DATA_DIR=D:\GEO_SERVE

# The other machines running this package, comma separated.
# Use their Tailscale address: it keeps working when the two laptops are on
# different networks, which a 192.168 address does not.
UN_PEERS=http://100.74.15.17:8790

# Shared secret. Must be IDENTICAL on both laptops, or they will see each
# other but refuse to exchange files. Any long random string.
UN_API_KEY=

# Ports. Only change if something else already uses them.
UN_NODE_PORT=8790
UN_GPU_PORT=8800
UN_DATA_PORT=8777
